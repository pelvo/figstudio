// The public browser build at https://figstudio.pelvo.dev, deployed by
// .github/workflows/web-deploy.yml on every release. Static assets only: no Worker script and
// no Durable Object, so no cloud relay (the app hides Cloud relay after its GET /mcp/ probe
// answers 404). No account ID here: the workflow passes CLOUDFLARE_ACCOUNT_ID.
// For your own deploy with the relay, use web/wrangler.jsonc (git-ignored, see .gitignore).
{
  "name": "figstudio-public",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist" },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "figstudio.pelvo.dev", "custom_domain": true }]
}
