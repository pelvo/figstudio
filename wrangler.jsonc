{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "figstudio-relay-example",
  "main": "web/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "MCP_ROOMS", "class_name": "McpRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpRoom"] }]
}
